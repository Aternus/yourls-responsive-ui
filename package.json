{
    "name": "yourls-responsive-ui",
    "version": "0.0.0",
    "private": true,
    "description": "YOURLS Responsive UI",
    "main": "index.js",
    "scripts": {
        "dev": "sass --watch src/css/theme.scss:release/css/theme.css --source-map",
        "build": "sass src/css/theme.scss:release/css/theme.css --style=compressed --source-map",
        "test:e2e": "playwright test",
        "format": "prettier --write 'src/**/*.{js,scss}'",
        "format:check": "prettier --check 'src/**/*.{js,scss}'"
    },
    "author": "Kiril Reznik",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "playwright": "^1.58.2",
        "prettier": "3.8.1",
        "sass": "^1.80.0"
    },
    "engines": {
        "node": ">=22"
    }
}
