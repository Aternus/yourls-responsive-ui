{
  "name": "yourls-responsive-ui",
  "version": "0.0.0",
  "private": true,
  "description": "YOURLS Responsive UI",
  "main": "index.js",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/css/app.css -o ./release/css/app.css --watch --map",
    "build": "npx @tailwindcss/cli -i ./src/css/app.css -o ./release/css/app.css --minify",
    "test:e2e": "playwright test",
    "format:php": "docker compose exec -w /var/www/html/user/plugins/yourls-responsive-ui web ./vendor/bin/phpcbf",
    "format:php:check": "docker compose exec -w /var/www/html/user/plugins/yourls-responsive-ui web ./vendor/bin/phpcs",
    "format:tailwind": "rustywind --output-css-file release/css/app.css --write src/",
    "format:tailwind:check": "rustywind --output-css-file release/css/app.css --check-formatted src/",
    "format": "prettier --write 'src/**/*.{js,css,scss}' && npm run format:php && npm run format:tailwind",
    "format:check": "prettier --check 'src/**/*.{js,css,scss}' && npm run format:php:check && npm run format:tailwind:check"
  },
  "author": {
    "name": "Kiril Reznik",
    "email": "kiril@atern.us"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/forms": "0.5.11",
    "class-variance-authority": "0.7.1",
    "daisyui": "5.5.19",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rustywind": "0.24.3",
    "tailwindcss": "4.2.2",
    "vue": "3.5.32"
  }
}
